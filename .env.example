# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- server-only (Vercel env, not VITE_) ---
# Used by api/db.js and api/mcp.js to reach Supabase from the serverless side.
SB_URL=https://YOUR-PROJECT.supabase.co
SB_KEY=your-anon-public-key

# Shared secret for the MCP connector (api/mcp.js). If set, clients must pass
# it as ?key=<token>, Authorization: Bearer <token>, or X-Api-Key. Leave unset
# to make the connector open (same "link = access" model as the app itself).
NOXEL_MCP_TOKEN=
